# Скопируйте в .env (cp .env.example .env) и заполните перед первым
# запуском: docker compose up --build -d
#
# .env НЕ должен попадать в git — уже добавлен в .gitignore.

# --- PostgreSQL (используется контейнером postgres и подставляется в
#     DATABASE_URL внутри docker-compose.yml — сюда просто логин/пароль/имя БД) ---
POSTGRES_USER=mtk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mikrotik_manager

# --- Backend (см. backend/src/config.ts) ---

# Секрет для подписи JWT-токенов сессий. Сгенерировать:
#   openssl rand -hex 32
JWT_SECRET=change-me

# 32-байтный ключ (hex) для AES-256-GCM — им шифруются пароли роутеров
# перед записью в БД. Сгенерировать:
#   openssl rand -hex 32
# ВАЖНО: потеря/смена этого ключа на уже заполненной базе делает все
# сохранённые пароли роутеров нерасшифровываемыми — их придётся ввести
# заново. Храните ключ отдельно от бэкапа БД (например, в менеджере
# секретов), не только в .env на сервере.
MASTER_KEY=change-me

# Порт, на котором слушает API внутри контейнера (обычно не менять —
# docker-compose всё равно пробрасывает наружу 3000:3000).
PORT=3000

# Как часто воркер опрашивает роутеры, мс.
POLL_INTERVAL_MS=15000

# Необязательно: если заданы и таблица users ещё пуста при первом старте,
# автоматически создаётся тенант и admin-аккаунт под этими данными.
# Если не заданы — после первого запуска выполните:
#   docker compose exec api node dist/scripts/seed.js
# (создаст demo-тенант и admin/admin123 — смените пароль сразу после входа).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me
